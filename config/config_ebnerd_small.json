{
  "dataset": {
    "name": "ebnerd",
    "input_path": "data/ebnerd/ebnerd_small"
  },
  "clustering": {
    "k_selection_method": "elbow",
    "legacy_features": true,
    "remove_top": 0
  },
  "evaluation": {
    "k_values": [10, 20, 50],
    "content_mode": "embeddings",
    "train_on_full_dataset": true,
    "n_most_recent_in": 30,
    "algorithms": [
      { "name": "Popularity", "enabled": true },
      {
        "name": "ItemKNN",
        "enabled": true,
        "grid": {
          "K": [50, 100, 200],
          "normalize_sim": [true, false],
          "normalize_X": [true, false]
        }
      },
      { "name": "EASE", "enabled": true, "grid": { "l2": [1, 10, 100, 1000] } },
      {
        "name": "MultVAE",
        "enabled": true,
        "params": { "batch_size": 500, "dropout": 0.5, "max_epochs": 30 },
        "grid": {
          "learning_rate": [0.0001, 0.001],
          "dim_bottleneck_layer": [100, 200, 400],
          "dim_hidden_layer": [400, 600],
          "anneal_steps": [50000, 200000]
        }
      },
      { "name": "CB-ST", "enabled": true }
    ]
  }
}
